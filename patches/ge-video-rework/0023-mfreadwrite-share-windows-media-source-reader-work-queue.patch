From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: atty303 <atty303@users.noreply.github.com>
Date: Mon, 24 Aug 2026 19:30:00 +0900
Subject: [PATCH] mfreadwrite: share Windows Media source reader work queues

Wine's RT work queue implementation provides 124 private queue handles.
Audio-only Windows Media users can exhaust those handles when they create
many source readers because each reader otherwise allocates a private serial
queue.

Use the shared queue whenever a reader contains either Windows Media audio or
Windows Media video.  This retains serial queues for the other media paths
covered by the source reader rework while also preserving the existing shared
queue behavior and EOS handling for combined WMA and WMV streams.
---
 dlls/mfreadwrite/reader.c | 31 +++++++++++++++++++------------
 1 file changed, 19 insertions(+), 12 deletions(-)

diff --git a/dlls/mfreadwrite/reader.c b/dlls/mfreadwrite/reader.c
index 659b9470d5d..680d815f1aa 100644
--- a/dlls/mfreadwrite/reader.c
+++ b/dlls/mfreadwrite/reader.c
@@ -3649,11 +3649,13 @@ static DWORD reader_get_first_stream_index(IMFPresentationDescriptor *descriptor
     return MF_SOURCE_READER_INVALID_STREAM_INDEX;
 }
 
-static BOOL source_reader_has_windows_media_av_streams(const struct source_reader *reader)
+static void source_reader_get_windows_media_streams(const struct source_reader *reader,
+        BOOL *has_windows_media_audio, BOOL *has_windows_media_video)
 {
-    BOOL has_windows_media_audio = FALSE, has_windows_media_video = FALSE;
     unsigned int i;
 
+    *has_windows_media_audio = *has_windows_media_video = FALSE;
+
     for (i = 0; i < reader->stream_count; ++i)
     {
         GUID subtype = GUID_NULL;
@@ -3665,21 +3667,20 @@ static BOOL source_reader_has_windows_media_av_streams(const struct source_reader
                 || IsEqualGUID(&subtype, &MFAudioFormat_WMAudioV9)
                 || IsEqualGUID(&subtype, &MFAudioFormat_WMAudio_Lossless)
                 || IsEqualGUID(&subtype, &MFAudioFormat_WMASPDIF))
-            has_windows_media_audio = TRUE;
+            *has_windows_media_audio = TRUE;
         else if (IsEqualGUID(&subtype, &MFVideoFormat_WMV1)
                 || IsEqualGUID(&subtype, &MFVideoFormat_WMV2)
                 || IsEqualGUID(&subtype, &MFVideoFormat_WMV3)
                 || IsEqualGUID(&subtype, &MFVideoFormat_WVC1))
-            has_windows_media_video = TRUE;
+            *has_windows_media_video = TRUE;
     }
-
-    return has_windows_media_audio && has_windows_media_video;
 }
 
 static HRESULT create_source_reader_from_source(IMFMediaSource *source, IMFAttributes *attributes,
         BOOL shutdown_on_release, REFIID riid, void **out)
 {
     struct source_reader *object;
+    BOOL has_windows_media_audio, has_windows_media_video;
     unsigned int i;
     HRESULT hr;
 
@@ -3770,16 +3771,22 @@ static HRESULT create_source_reader_from_source(IMFMediaSource *source, IMFAttrib
         hr = MF_E_ATTRIBUTENOTFOUND;
     }
 
-    if (source_reader_has_windows_media_av_streams(object))
+    source_reader_get_windows_media_streams(object, &has_windows_media_audio, &has_windows_media_video);
+
+    if (has_windows_media_audio && has_windows_media_video)
     {
         /* Some Windows Media A/V callers keep reading each selected stream until
          * every selected stream reports EOS, instead of stopping on a single
-         * MF_SOURCE_READER_ANY_STREAM EOS result.
-         *
-         * Keep these streams off the serial queue: WVC1 decode can run long
-         * enough to starve WMA sample delivery when both stream event callbacks
-         * are serialized behind the same reader queue. */
+         * MF_SOURCE_READER_ANY_STREAM EOS result. */
         object->flag_eos_for_all_streams = TRUE;
+    }
+
+    if (has_windows_media_audio || has_windows_media_video)
+    {
+        /* Keep Windows Media streams off the serial queue: WVC1 decode can run long
+         * enough to starve WMA sample delivery when both stream event callbacks
+         * are serialized behind the same reader queue, while WMA-only readers can
+         * exhaust the finite private work queue handle pool. */
         if (FAILED(hr = MFLockSharedWorkQueue(L"", 0, NULL, &object->queue)))
         {
             WARN("Failed to acquire shared source reader work queue, hr %#lx.\n", hr);
-- 
2.51.0

