+    TRACE_(mfdrain)("event=source_reader_stream_state action=error reader=%p source=%p stream=%u"
+            " state=draining reason=%s requests=%u responses=%u status=%#lx\n", reader, reader->source,
+            stream->index, reason, stream->requests, stream->responses, status);
+    source_reader_cancel_stream_drain(reader, stream, STREAM_STATE_EOS, reason, status);
+    while (stream->requests)
+    {
+        queue_hr = source_reader_queue_response(reader, stream, status, MF_SOURCE_READERF_ERROR, 0, NULL);
+        if (FAILED(queue_hr))
+        {
