+static HRESULT source_reader_push_drain_sample(struct source_reader *reader, struct media_stream *stream,
+        struct transform_entry *entry, IMFSample *sample, BOOL *accepted)
+{
+    unsigned int attempt;
+    HRESULT hr;
+
+    *accepted = FALSE;
+    for (attempt = 1; attempt <= 2; ++attempt)
+    {
+        hr = IMFTransform_ProcessInput(entry->transform, 0, sample, 0);
+        TRACE_(mfdrain)("event=source_reader_transform action=drain_input reader=%p source=%p stream=%u"
+                " transform=%p attempt=%u status=%#lx requests=%u responses=%u\n", reader, reader->source,
+                stream->index, entry->transform, attempt, hr, stream->requests, stream->responses);
+        if (SUCCEEDED(hr))
+        {
+            *accepted = TRUE;
+            return source_reader_pull_transform_samples(reader, stream, entry, TRUE);
+        }
+        if (hr != MF_E_NOTACCEPTING)
+            return hr;
+        if (!stream->requests)
+            return S_OK;
+
+        hr = source_reader_pull_transform_samples(reader, stream, entry, TRUE);
+        if (FAILED(hr) && !source_reader_is_nonfatal_transform_status(hr))
+            return hr;
+        if (!stream->requests)
+            return S_OK;
+    }
+
+    return MF_E_NOTACCEPTING;
+}
