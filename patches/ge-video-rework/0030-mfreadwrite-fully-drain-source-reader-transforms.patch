+static HRESULT source_reader_begin_stream_drain(struct source_reader *reader, struct media_stream *stream,
+        const char *origin)
+{
+    struct list *ptr;
+    HRESULT hr;
+
+    stream->flags &= ~(STREAM_FLAG_SAMPLE_REQUESTED | STREAM_FLAG_EOS_REPORTED);
+    stream->state = STREAM_STATE_DRAINING;
+    stream->draining_transform = NULL;
+    source_reader_clear_drain_sample(stream);
+
+    TRACE_(mfdrain)("event=source_reader_stream_state action=transition reader=%p source=%p stream=%u"
+            " from=ready to=draining reason=%s requests=%u responses=%u\n", reader, reader->source,
+            stream->index, origin, stream->requests, stream->responses);
+    TRACE_(wmadiag)("event=source_reader_stream_state action=draining origin=%s reader=%p source=%p stream=%u"
+            " requests=%u responses=%u\n", origin, reader, reader->source, stream->index,
+            stream->requests, stream->responses);
+
+    if (!(ptr = list_head(&stream->transforms)))
+        return source_reader_finish_stream_drain(reader, stream, "no_transform", S_OK);
+
+    stream->draining_transform = LIST_ENTRY(ptr, struct transform_entry, entry);
+    if (FAILED(hr = source_reader_start_transform_drain(reader, stream, stream->draining_transform)))
+        return source_reader_fail_stream_drain(reader, stream, "drain_message_error", hr);
+    return source_reader_service_stream_drain(reader, stream);
+}
+
+static HRESULT source_reader_service_stream_drain(struct source_reader *reader, struct media_stream *stream)
+{
+    struct transform_entry *entry;
+    struct list *ptr;
+    HRESULT hr = S_OK;
+
+    TRACE_(mfdrain)("event=source_reader_drain action=service_begin reader=%p source=%p stream=%u"
+            " transform=%p retained_sample=%p retained_transform=%p requests=%u responses=%u\n",
+            reader, reader->source, stream->index,
+            stream->draining_transform ? stream->draining_transform->transform : NULL,
+            stream->draining_sample,
+            stream->draining_sample_transform ? stream->draining_sample_transform->transform : NULL,
+            stream->requests, stream->responses);
+
+    while (stream->state == STREAM_STATE_DRAINING && stream->requests)
+    {
+        if (stream->draining_sample)
+        {
+            struct transform_entry *sample_transform = stream->draining_sample_transform;
+            IMFSample *sample = stream->draining_sample;
+            BOOL accepted;
+
+            stream->draining_sample = NULL;
+            stream->draining_sample_transform = NULL;
+            hr = source_reader_push_drain_sample(reader, stream, sample_transform, sample, &accepted);
+            if (!accepted && SUCCEEDED(hr))
+            {
+                stream->draining_sample = sample;
+                stream->draining_sample_transform = sample_transform;
+                TRACE_(mfdrain)("event=source_reader_drain action=retain_sample reader=%p source=%p"
+                        " stream=%u transform=%p requests=%u responses=%u\n", reader, reader->source,
+                        stream->index, sample_transform->transform, stream->requests, stream->responses);
+                break;
+            }
+            IMFSample_Release(sample);
+            if (FAILED(hr) && !source_reader_is_nonfatal_transform_status(hr))
+            {
+                WARN("Failed to submit retained drain sample, hr %#lx.\n", hr);
+                hr = source_reader_fail_stream_drain(reader, stream, "drain_input_error", hr);
+                break;
+            }
+            if (!stream->requests)
+                break;
+        }
+
+        entry = stream->draining_transform;
+        if (!entry)
+        {
+            hr = source_reader_fail_stream_drain(reader, stream, "missing_transform", E_UNEXPECTED);
+            break;
+        }
+        hr = source_reader_pull_transform_samples(reader, stream, entry, TRUE);
+        if (hr == MF_E_TRANSFORM_NEED_MORE_INPUT || hr == MF_E_END_OF_STREAM)
+        {
+            if ((ptr = list_next(&stream->transforms, &entry->entry)))
+            {
+                stream->draining_transform = LIST_ENTRY(ptr, struct transform_entry, entry);
+                if (FAILED(hr = source_reader_start_transform_drain(reader, stream, stream->draining_transform)))
+                {
+                    hr = source_reader_fail_stream_drain(reader, stream, "drain_message_error", hr);
+                    break;
+                }
+                continue;
+            }
+
+            hr = source_reader_finish_stream_drain(reader, stream, "transform_empty", hr);
+            break;
+        }
+        if (FAILED(hr))
+        {
+            WARN("Failed to pull pending samples, hr %#lx.\n", hr);
+            hr = source_reader_fail_stream_drain(reader, stream, "transform_error", hr);
+            break;
+        }
+    }
+
+    TRACE_(mfdrain)("event=source_reader_drain action=service_end reader=%p source=%p stream=%u"
+            " transform=%p retained_sample=%p retained_transform=%p requests=%u responses=%u"
+            " state=%u status=%#lx\n", reader, reader->source,
+            stream->index, stream->draining_transform ? stream->draining_transform->transform : NULL,
+            stream->draining_sample,
+            stream->draining_sample_transform ? stream->draining_sample_transform->transform : NULL,
+            stream->requests, stream->responses, stream->state, hr);
+
+    return FAILED(hr) && !source_reader_is_nonfatal_transform_status(hr) ? hr : S_OK;
 }
 
