+static void source_reader_cancel_stream_drain(struct source_reader *reader, struct media_stream *stream,
+        enum media_stream_state state, const char *reason, HRESULT status)
+{
+    if (stream->state == STREAM_STATE_DRAINING)
+        TRACE_(mfdrain)("event=source_reader_stream_state action=transition reader=%p source=%p stream=%u"
+                " from=draining to=%s reason=%s requests=%u responses=%u status=%#lx\n", reader,
+                reader->source, stream->index, source_reader_stream_state_name(state), reason,
+                stream->requests, stream->responses, status);
+    stream->state = state;
+    stream->draining_transform = NULL;
+    source_reader_clear_drain_sample(stream);
+}
+
+static HRESULT source_reader_finish_stream_drain(struct source_reader *reader, struct media_stream *stream,
+        const char *reason, HRESULT status)
+{
+    HRESULT hr = S_OK, queue_hr;
+
+    TRACE_(wmadiag)("event=source_reader_stream_state action=eos origin=drain reader=%p source=%p stream=%u"
+            " requests=%u responses=%u status=%#lx\n", reader, reader->source, stream->index,
+            stream->requests, stream->responses, status);
+
+    source_reader_cancel_stream_drain(reader, stream, STREAM_STATE_EOS, reason, status);
+    while (stream->requests)
+    {
+        queue_hr = source_reader_queue_response(reader, stream, S_OK, MF_SOURCE_READERF_ENDOFSTREAM, 0, NULL);
+        if (FAILED(queue_hr))
+        {
+            hr = queue_hr;
+            break;
+        }
+    }
+
+    return hr;
+}
