+
+    sequence = source_reader_read_refcount(&reader->diagnostic_read_sequence);
+    TRACE_(mfdrain)("event=source_reader_wait action=%s reason=%s reader=%p source=%p sequence=%ld"
+            " requested_stream=%#lx control_flags=%#lx source_state=%u source_flags=%#x"
+            " presentation_ended=%u\n", action, reason, reader, reader->source, sequence, requested_stream,
+            control_flags, reader->source_state, reader->flags, reader->presentation_ended);
+
+    for (i = 0; i < reader->stream_count; ++i)
+    {
+        selected = FALSE;
+        source_reader_get_stream_selection(reader, i, &selected);
+        TRACE_(mfdrain)("event=source_reader_wait_state action=%s reason=%s reader=%p source=%p sequence=%ld"
+                " requested_stream=%#lx control_flags=%#lx stream=%u selected=%u state=%s requests=%u"
+                " responses=%u stream_flags=%#x transform=%p retained_sample=%p retained_transform=%p\n",
+                action, reason, reader, reader->source,
+                sequence, requested_stream, control_flags, i, selected,
+                source_reader_stream_state_name(reader->streams[i].state), reader->streams[i].requests,
+                reader->streams[i].responses, reader->streams[i].flags,
+                reader->streams[i].draining_transform
+                        ? reader->streams[i].draining_transform->transform : NULL,
+                reader->streams[i].draining_sample,
+                reader->streams[i].draining_sample_transform
+                        ? reader->streams[i].draining_sample_transform->transform : NULL);
+    }
+}
