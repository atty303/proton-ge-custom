+static BOOL source_reader_wait_should_trace(struct source_reader *reader, DWORD requested_stream)
+{
+    unsigned int i;
+    BOOL selected;
+
+    for (i = 0; i < reader->stream_count; ++i)
+    {
+        if (reader->streams[i].state != STREAM_STATE_DRAINING)
+            continue;
+        if (requested_stream == i)
+            return TRUE;
+        if (requested_stream == MF_SOURCE_READER_ANY_STREAM
+                && SUCCEEDED(source_reader_get_stream_selection(reader, i, &selected)) && selected)
+            return TRUE;
+    }
+    return FALSE;
+}
