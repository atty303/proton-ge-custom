From: atty303 <atty303@users.noreply.github.com>
Date: Sun, 30 Aug 2026 00:00:00 +0900
Subject: [PATCH 1/2] winhttp: Match receive response timeout option state

Windows 11 build 26200 reports a 30 second receive timeout and a 90 second
receive-response timeout by default, but distinguishes that default response
value from one explicitly configured by the application.

Track the explicit state separately, clamp an explicit response timeout to the
current receive timeout, and preserve the timeout snapshot when a request is
created.  Keep INFINITE as a distinct DWORD value instead of relying on signed
comparisons.

Add session and request tests for the observed setter matrix and request
inheritance.

diff --git a/dlls/winhttp/session.c b/dlls/winhttp/session.c
index 22f209fffca355f2fbbfe67b979523faf924bd97..c5eeca69712698f4290c35dad8122ecfb871ba3b 100644
--- a/dlls/winhttp/session.c
+++ b/dlls/winhttp/session.c
@@ -42,7 +42,34 @@ WINE_DEFAULT_DEBUG_CHANNEL(winhttp);
 #define DEFAULT_CONNECT_TIMEOUT             20000
 #define DEFAULT_SEND_TIMEOUT                30000
 #define DEFAULT_RECEIVE_TIMEOUT             30000
-#define DEFAULT_RECEIVE_RESPONSE_TIMEOUT    ~0u
+#define DEFAULT_RECEIVE_RESPONSE_TIMEOUT    90000
+
+static DWORD max_timeout( DWORD timeout, DWORD minimum )
+{
+    if (timeout == INFINITE || minimum == INFINITE) return INFINITE;
+    return max( timeout, minimum );
+}
+
+static DWORD get_receive_response_timeout( DWORD receive_timeout, DWORD response_timeout,
+                                           BOOL response_timeout_set )
+{
+    if (response_timeout_set) return response_timeout;
+    return max_timeout( DEFAULT_RECEIVE_RESPONSE_TIMEOUT, receive_timeout );
+}
+
+static void set_receive_timeout( DWORD *receive_timeout, DWORD *response_timeout,
+                                 BOOL response_timeout_set, DWORD timeout )
+{
+    *receive_timeout = timeout;
+    if (response_timeout_set) *response_timeout = max_timeout( *response_timeout, timeout );
+}
+
+static void set_receive_response_timeout( DWORD receive_timeout, DWORD *response_timeout,
+                                          BOOL *response_timeout_set, DWORD timeout )
+{
+    *response_timeout = max_timeout( timeout, receive_timeout );
+    *response_timeout_set = TRUE;
+}
 
