+static DWORD query_timeout_option(HINTERNET handle, DWORD option)
+{
+    DWORD value = 0xdeadbeef, size = sizeof(value);
+    BOOL ret;
+
+    ret = WinHttpQueryOption(handle, option, &value, &size);
+    ok(ret, "WinHttpQueryOption(%lu) failed: %lu\n", option, GetLastError());
+    ok(size == sizeof(value), "unexpected size %lu\n", size);
+    return value;
+}
+
+static void set_timeout_option(HINTERNET handle, DWORD option, DWORD value)
+{
+    BOOL ret = WinHttpSetOption(handle, option, &value, sizeof(value));
+    ok(ret, "WinHttpSetOption(%lu, %lu) failed: %lu\n", option, value, GetLastError());
+}
+
+static void test_receive_response_timeout_options(void)
+{
+    static const struct
+    {
+        BOOL set_receive;
+        DWORD receive;
+        BOOL set_response;
+        DWORD response;
+        BOOL response_first;
+        DWORD expected_receive;
+        DWORD expected_response;
+    }
+    tests[] =
+    {
+        {FALSE, 0,      FALSE, 0,        FALSE, 30000,    90000},
+        {FALSE, 0,      TRUE,  0,        FALSE, 30000,    30000},
+        {FALSE, 0,      TRUE,  1000,     FALSE, 30000,    30000},
+        {TRUE,  2000,   FALSE, 0,        FALSE, 2000,     90000},
+        {TRUE,  2000,   TRUE,  3000,     FALSE, 2000,     3000},
+        {TRUE,  4000,   TRUE,  3000,     FALSE, 4000,     4000},
+        {TRUE,  4000,   TRUE,  3000,     TRUE,  4000,     4000},
+        {TRUE,  120000, FALSE, 0,        FALSE, 120000,   120000},
+        {TRUE,  0,      FALSE, 0,        FALSE, 0,        90000},
+        {TRUE,  INFINITE, FALSE, 0,      FALSE, INFINITE, INFINITE},
+        {FALSE, 0,      TRUE,  INFINITE, FALSE, 30000,    INFINITE},
+    };
+    unsigned int handle_type, i;
+
+    for (handle_type = 0; handle_type < 2; ++handle_type)
+    {
+        for (i = 0; i < ARRAY_SIZE(tests); ++i)
+        {
+            HINTERNET session, connect = NULL, request = NULL, target;
+
+            winetest_push_context("handle %s, test %u", handle_type ? "request" : "session", i);
+            session = WinHttpOpen(L"winetest", 0, NULL, NULL, 0);
+            ok(!!session, "WinHttpOpen failed: %lu\n", GetLastError());
+            if (handle_type)
+            {
+                connect = WinHttpConnect(session, L"localhost", 80, 0);
+                ok(!!connect, "WinHttpConnect failed: %lu\n", GetLastError());
+                request = WinHttpOpenRequest(connect, NULL, NULL, NULL, NULL, NULL, 0);
+                ok(!!request, "WinHttpOpenRequest failed: %lu\n", GetLastError());
+                target = request;
+            }
+            else target = session;
+
+            if (tests[i].response_first && tests[i].set_response)
+                set_timeout_option(target, WINHTTP_OPTION_RECEIVE_RESPONSE_TIMEOUT, tests[i].response);
+            if (tests[i].set_receive)
+                set_timeout_option(target, WINHTTP_OPTION_RECEIVE_TIMEOUT, tests[i].receive);
+            if (!tests[i].response_first && tests[i].set_response)
+                set_timeout_option(target, WINHTTP_OPTION_RECEIVE_RESPONSE_TIMEOUT, tests[i].response);
+
+            ok(query_timeout_option(target, WINHTTP_OPTION_RECEIVE_TIMEOUT) == tests[i].expected_receive,
+                    "unexpected receive timeout\n");
+            ok(query_timeout_option(target, WINHTTP_OPTION_RECEIVE_RESPONSE_TIMEOUT) == tests[i].expected_response,
+                    "unexpected receive response timeout\n");
+
+            if (request) WinHttpCloseHandle(request);
+            if (connect) WinHttpCloseHandle(connect);
+            WinHttpCloseHandle(session);
+            winetest_pop_context();
+        }
+    }
+}
+
+static void test_receive_response_timeout_retention(void)
+{
+    unsigned int handle_type;
+
+    for (handle_type = 0; handle_type < 2; ++handle_type)
+    {
+        HINTERNET session, connect = NULL, request = NULL, target;
+
+        winetest_push_context("handle %s", handle_type ? "request" : "session");
+        session = WinHttpOpen(L"winetest", 0, NULL, NULL, 0);
+        ok(!!session, "WinHttpOpen failed: %lu\n", GetLastError());
+        if (handle_type)
+        {
+            connect = WinHttpConnect(session, L"localhost", 80, 0);
+            ok(!!connect, "WinHttpConnect failed: %lu\n", GetLastError());
+            request = WinHttpOpenRequest(connect, NULL, NULL, NULL, NULL, NULL, 0);
+            ok(!!request, "WinHttpOpenRequest failed: %lu\n", GetLastError());
+            target = request;
+        }
+        else target = session;
+
+        set_timeout_option(target, WINHTTP_OPTION_RECEIVE_TIMEOUT, 2000);
+        set_timeout_option(target, WINHTTP_OPTION_RECEIVE_RESPONSE_TIMEOUT, 3000);
+        set_timeout_option(target, WINHTTP_OPTION_RECEIVE_TIMEOUT, 4000);
+        ok(query_timeout_option(target, WINHTTP_OPTION_RECEIVE_RESPONSE_TIMEOUT) == 4000,
+                "unexpected raised response timeout\n");
+        set_timeout_option(target, WINHTTP_OPTION_RECEIVE_TIMEOUT, 1000);
+        ok(query_timeout_option(target, WINHTTP_OPTION_RECEIVE_TIMEOUT) == 1000,
+                "unexpected lowered receive timeout\n");
+        ok(query_timeout_option(target, WINHTTP_OPTION_RECEIVE_RESPONSE_TIMEOUT) == 4000,
+                "response timeout was lowered\n");
+
+        if (request) WinHttpCloseHandle(request);
+        if (connect) WinHttpCloseHandle(connect);
+        WinHttpCloseHandle(session);
+        winetest_pop_context();
+    }
+}
+
+static void test_receive_response_timeout_inheritance(void)
+{
+    HINTERNET session, connect, request1, request2;
+
+    session = WinHttpOpen(L"winetest", 0, NULL, NULL, 0);
+    ok(!!session, "WinHttpOpen failed: %lu\n", GetLastError());
+    set_timeout_option(session, WINHTTP_OPTION_RECEIVE_TIMEOUT, 2000);
+    set_timeout_option(session, WINHTTP_OPTION_RECEIVE_RESPONSE_TIMEOUT, 3000);
+    connect = WinHttpConnect(session, L"localhost", 80, 0);
+    ok(!!connect, "WinHttpConnect failed: %lu\n", GetLastError());
+    request1 = WinHttpOpenRequest(connect, NULL, NULL, NULL, NULL, NULL, 0);
+    ok(!!request1, "WinHttpOpenRequest failed: %lu\n", GetLastError());
+
+    set_timeout_option(session, WINHTTP_OPTION_RECEIVE_TIMEOUT, 4000);
+    request2 = WinHttpOpenRequest(connect, NULL, NULL, NULL, NULL, NULL, 0);
+    ok(!!request2, "WinHttpOpenRequest failed: %lu\n", GetLastError());
+
+    ok(query_timeout_option(session, WINHTTP_OPTION_RECEIVE_TIMEOUT) == 4000,
+            "unexpected session receive timeout\n");
+    ok(query_timeout_option(session, WINHTTP_OPTION_RECEIVE_RESPONSE_TIMEOUT) == 4000,
+            "unexpected session response timeout\n");
+    ok(query_timeout_option(request1, WINHTTP_OPTION_RECEIVE_TIMEOUT) == 2000,
+            "unexpected existing request receive timeout\n");
+    ok(query_timeout_option(request1, WINHTTP_OPTION_RECEIVE_RESPONSE_TIMEOUT) == 3000,
+            "unexpected existing request response timeout\n");
+    ok(query_timeout_option(request2, WINHTTP_OPTION_RECEIVE_TIMEOUT) == 4000,
+            "unexpected new request receive timeout\n");
+    ok(query_timeout_option(request2, WINHTTP_OPTION_RECEIVE_RESPONSE_TIMEOUT) == 4000,
+            "unexpected new request response timeout\n");
+
+    WinHttpCloseHandle(request2);
+    WinHttpCloseHandle(request1);
+    WinHttpCloseHandle(connect);
+    WinHttpCloseHandle(session);
+}
